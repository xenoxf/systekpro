---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import styles from '@/styles/Nosotros.module.css';
import { datosEmpresa } from '@/data/info';

const departamentos = [
  {
    img: '/departamentos/gerencia.jpg',
    name: 'Gerencia',
    focus: 'Planea el trabajo, asigna responsables y responde por cada entrega.',
    tasks: ['Plan de trabajo y prioridades por semana', 'Revisión de entregas antes de entregar al cliente', 'Decisiones de precios y garantías'],
  },
  {
    img: '/departamentos/administracion.jpg',
    name: 'Administración',
    focus: 'Agenda, compras, contratos y cuentas claras.',
    tasks: ['Agendamiento de visitas y soportes', 'Compras de materiales y control de inventario', 'Contratos, facturación y pagos'],
  },
  {
    img: '/departamentos/redes.jpg',
    name: 'Redes y cableado estructurado',
    focus: 'Diseño e instalación de redes de datos y cableado CAT6/CAT6A.',
    tasks: ['Planos, puntos de red y racks', 'Instalación y certificación de cableado', 'Configuración de routers y switches'],
  },
  {
    img: '/departamentos/mantenimiento_pc.jpg',
    name: 'Mantenimiento de equipos',
    focus: 'Preventivo y correctivo de computadores e impresoras.',
    tasks: ['Limpieza, pasta térmica y diagnóstico', 'Reparación de hardware y software', 'Optimización y respaldo de información'],
  },
  {
    img: '/departamentos/desarrollo_web.jpg',
    name: 'Desarrollo web y backend',
    focus: 'Páginas web, backend, bases de datos y mantenimiento.',
    tasks: ['Diseño y desarrollo de sitios', 'Formularios, API y panel administrable', 'Actualizaciones y copias de seguridad'],
  },
  {
    img: '/departamentos/marketing.jpg',
    name: 'Marketing y comercial',
    focus: 'Cotizaciones, seguimiento a clientes y divulgación.',
    tasks: ['Cotizaciones con precio cerrado', 'Seguimiento post-servicio', 'Material y canales de contacto'],
  },
  {
    img: '/departamentos/capacitacion.jpg',
    name: 'Capacitación',
    focus: 'Formación interna del equipo y del cliente en cada entrega.',
    tasks: ['Capacitación en uso de equipos y red', 'Manuales de entrega por proyecto', 'Entrenamiento interno del equipo'],
  },
];

const evidencias = [
  { img: '/evidencias/todos_trabajando.jpg', alt: 'El equipo de Sistek Pro trabajando en conjunto' },
  { img: '/evidencias/redes_trabajando.jpg', alt: 'Instalación de red en sitio por el equipo de Sistek Pro' },
  { img: '/evidencias/redes_trabajando_2.jpg', alt: 'Técnico configurando equipos de red' },
  { img: '/evidencias/mantenimiento_pc.jpg', alt: 'Mantenimiento preventivo a un computador' },
  { img: '/evidencias/alguien_codeando.jpg', alt: 'Desarrollo de un sitio web a medida' },
  { img: '/evidencias/codeando_sitio_web.jpg', alt: 'Programación de la página web de un cliente' },
  { img: '/evidencias/marketing_work.jpg', alt: 'Reunión de trabajo del equipo de marketing' },
  { img: '/evidencias/marketing_work-look-system.jpg', alt: 'Planeación de campaña de marketing digital' },
  { img: '/evidencias/personal_trabajando-puedesercualquierdepartamento.jpg', alt: 'Personal de Sistek Pro en actividad de capacitación' },
];
---

<Layout
  title="Nosotros | Sistek Pro"
  description="Sistek Pro en Cali: organigrama y departamentos de gerencia, administración, redes, mantenimiento, desarrollo web, marketing y capacitación."
>
  <Navbar client:load />
  <main id="main" tabindex="-1">
    <section class={styles['about-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol>
            <li><a href="/">Inicio</a></li>
            <li aria-current="page">Nosotros</li>
          </ol>
        </nav>
        <h1>Nosotros</h1>
        <p class={styles['about-hero-desc']}>
          Sistek Pro es un equipo de trabajo organizado por departamentos.
          Instalamos redes, mantenemos equipos y desarrollamos páginas web
          para empresas, colegios y negocios en Cali y el Valle del Cauca.
        </p>
      </div>
    </section>

    <section class={styles['nosotros-section']} aria-labelledby="quienes-heading">
      <div class="container">
        <h2 id="quienes-heading" class={styles['section-title']}>Quiénes somos</h2>
        <p class={styles['section-desc']}>
          Un equipo caleño con roles definidos. Cada tarea tiene un responsable
          y cada entrega pasa por revisión.
        </p>
        <div class={styles['quienes-grid']}>
          <div class={styles['quienes-text']}>
            <p>
              <strong>Sistek Pro</strong> instala, configura y mantiene redes empresariales,
              cableado estructurado y equipos de cómputo. También desarrolla y mantiene
              páginas web con servicios backend. Trabajamos en Cali y el área metropolitana.
            </p>
            <p>
              La visita la hace personal de Sistek Pro
              y el seguimiento de cada servicio queda registrado por departamento.
            </p>
            <dl class={styles['quienes-facts']}>
              <div>
                <dt>Ciudad</dt>
                <dd>Cali, Valle del Cauca</dd>
              </div>
              <div>
                <dt>Cobertura</dt>
                <dd>Cali y área metropolitana, presencial y remoto</dd>
              </div>
              <div>
                <dt>Clientes</dt>
                <dd>Empresas, colegios y negocios</dd>
              </div>
              <div>
                <dt>Contacto</dt>
                <dd>WhatsApp {datosEmpresa.telefonoDisplay} · {datosEmpresa.direccion}</dd>
              </div>
            </dl>
          </div>
          <figure class={styles['quienes-photo']}>
            <img src="/departamentos/todos_departamentos.jpg" alt="Equipo completo de Sistek Pro por departamentos" loading="lazy" decoding="async" />
            <figcaption>Equipo Sistek Pro: todos los departamentos.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class={styles['nosotros-section']} aria-labelledby="org-heading">
      <div class="container">
        <h2 id="org-heading" class={styles['section-title']}>Organigrama</h2>
        <p class={styles['section-desc']}>
          Estructura de la empresa. Gerencia dirige; coordinación técnica
          agrupa las áreas que instalan y desarrollan.
        </p>
        <figure class={styles['org-figure']}>
          <img src="/info/organigrama.jpg" alt="Organigrama de Sistek Pro: gerencia, administración, coordinación técnica, marketing y capacitación" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <section class={styles['nosotros-section']} aria-labelledby="dept-heading">
      <div class="container">
        <h2 id="dept-heading" class={styles['section-title']}>Departamentos</h2>
        <p class={styles['section-desc']}>
          Cada departamento tiene una foto, una función principal
          y tres tareas concretas de las que responde.
        </p>
        <ul class={styles['depts-grid']}>
          {departamentos.map(d => (
            <li class={styles['dept-card']}>
              <img src={d.img} alt={`Departamento de ${d.name.toLowerCase()}`} class={styles['dept-photo']} loading="lazy" decoding="async" />
              <div class={styles['dept-body']}>
                <h3 class={styles['dept-name']}>{d.name}</h3>
                <p class={styles['dept-focus']}>{d.focus}</p>
                <ul class={styles['dept-list']}>
                  {d.tasks.map(t => (<li>{t}</li>))}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class={styles['nosotros-section']} aria-labelledby="evid-heading">
      <div class="container">
        <h2 id="evid-heading" class={styles['section-title']}>Así se ve nuestro trabajo</h2>
        <p class={styles['section-desc']}>
          Fotos reales de instalaciones, diagnósticos y entregas hechas por
          nuestro equipo en Cali y el área metropolitana.
        </p>
        <ul class={styles['evid-grid']}>
          {evidencias.map(e => (
            <li class={styles['evid-item']}>
              <img src={e.img} alt={e.alt} class={styles['evid-photo']} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class={styles['nosotros-section']} aria-labelledby="datos-heading">
      <div class="container">
        <h2 id="datos-heading" class={styles['section-title']}>Datos de la empresa</h2>
        <p class={styles['section-desc']}>Información básica para ubicarnos y contactarnos.</p>
        <dl class={styles['data-grid']}>
          <div class={styles['data-row']}><dt>Razón social</dt><dd>Sistek Pro</dd></div>
          <div class={styles['data-row']}><dt>Ciudad</dt><dd>Cali, Valle del Cauca, Colombia</dd></div>
          <div class={styles['data-row']}><dt>Dirección</dt><dd>Calle 41, Cra 31 #00, Cali</dd></div>
          <div class={styles['data-row']}><dt>WhatsApp</dt><dd><a href={`https://wa.me/${datosEmpresa.waNumber}`} target="_blank" rel="noopener noreferrer">{datosEmpresa.telefonoDisplay}</a></dd></div>
          <div class={styles['data-row']}><dt>Servicios</dt><dd><a href="/#servicios">Ver los 11 servicios</a></dd></div>
        </dl>
        <div class={styles['nosotros-cta']}>
          <a href="/#servicios" class="btn-primary">Ver servicios</a>
          <a href="/#contacto" class="btn-secondary">Solicitar cotización</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
