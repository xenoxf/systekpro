---
import Layout from "@/layouts/Layout.astro"
import "@/styles/sistema.css"
import SistemaApp from "@/components/sistema/SistemaApp"
---

<Layout title="Sistema | Sistek" description="Panel de administración de fichas técnicas y usuarios." accessibility={false}>
  <main id="main" tabindex="-1">
    <h1 class="sr-only">Sistema</h1>
    <div id="sistema">
      <SistemaApp client:only="react" />
    </div>
  </main>
</Layout>

<script>
  if (!localStorage.getItem("sistek.session")) {
    window.location.replace("/auth")
  }
</script>
