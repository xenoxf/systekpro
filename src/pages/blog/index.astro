---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/Blog.module.css';

const posts = [
  {
    slug: 'instalacion-red-empresarial-cali',
    title: 'Guía Completa: Cómo Instalar una Red Empresarial en Cali',
    description: 'Todo lo que necesitas saber sobre el diseño e instalación de redes empresariales. Desde el cableado estructurado hasta la configuración de switches y routers.',
    date: '2026-05-15',
    category: 'Redes',
    readTime: '8 min',
  },
];
---

<Layout
  title="Blog de Tecnología y Redes | Sistek Cali"
  description="Guías y consejos sobre redes, cableado y mantenimiento de equipos en Cali."
>
  <main id="main" tabindex="-1">
    <section class={styles['blog-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol>
            <li><a href="/">Inicio</a></li>
            <li aria-current="page">Blog</li>
          </ol>
        </nav>
        <h1>Blog de Tecnología</h1>
        <p class={styles['blog-hero-desc']}>Guías prácticas sobre redes, cableado y soporte en Cali.</p>
      </div>
    </section>

    <section class={styles['blog-list']}>
      <div class="container">
        <div class={styles['blog-grid']}>
          {posts.map(post => (
            <a href={`/blog/${post.slug}`} class={styles['blog-card']}>
              <div class={styles['blog-card-meta']}>
                <span class={styles['blog-card-category']}>{post.category}</span>
                <span class={styles['blog-card-date']}>{new Date(post.date).toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                <span class={styles['blog-card-read']}>{post.readTime}</span>
              </div>
              <h2 class={styles['blog-card-title']}>{post.title}</h2>
              <p class={styles['blog-card-desc']}>{post.description}</p>
              <span class={styles['blog-card-link']}>Leer más →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>


