---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import styles from '@/styles/ServicePage.module.css';
import { datosEmpresa } from '@/data/info';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';

const service = {
  name: 'Soporte Técnico para empresas y hogares',
  h1: 'Soporte Técnico en Cali',
  description: 'Soporte técnico en Cali. Presencial y remoto para empresas y hogares. Diagnóstico, reparación y mantenimiento de equipos.',
  keywords: 'soporte técnico cali, asistencia técnica computadores, soporte remoto, soporte presencial, técnico computadores, reparación PC domicilio',
  image: 'https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=1200&q=80&auto=format&fit=crop',
  imageAlt: 'Equipo brindando soporte técnico',
  intro: 'Diagnóstico y reparación en tu sede o por remoto. Precio claro antes de abrir el equipo y garantía escrita del trabajo.',
  waMsg: 'Hola Sistek Pro, vengo de la página de Soporte Técnico. Necesito ayuda con un equipo.',
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek Pro" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Soporte técnico"
};

const casos = [
  'El computador no arranca y ahí están las facturas del mes',
  'La laptop se calienta hasta que se apaga sola a mediodía',
  'Se perdieron archivos tras una actualización de rutina',
  'El equipo de recepción tarda minutos eternos en abrir el sistema',
  'Alguien descargó "un programa" y ahora todo salta con ventanas',
  'Se compró un equipo nuevo y falta pasarle los programas y la información del viejo',
];

const pasos = [
  { sub: 'Cuéntanos el caso', text: 'Con lo mínimo: qué equipo, qué pasa y cuándo empezó. De ahí decidimos si vamos en sitio o se intenta por remoto primero.' },
  { sub: 'Diagnóstico con precio', text: 'Antes de abrir nada sabemos qué pasa y se cotiza. Si hay repuesto, se cotiza aparte y solo se instala con tu aprobación.' },
  { sub: 'Trabajo', text: 'Reparamos en el sitio si se puede. Si el equipo necesita taller, te decimos qué se lleva, en cuándo lo entregamos y por qué.' },
  { sub: 'Prueba completa', text: 'Terminamos con el equipo encendido: tu sistema, tu correo y tus impresoras funcionando. Garantía del trabajo por escrito.' },
];

const incluye = [
  'Diagnóstico y reparación de hardware: disco, RAM, fuente, ventiladores y placas',
  'Sistemas operativos limpios, drivers, virus fuera y correo corporativo funcionando',
  'Impresoras de red, escáneres y periféricos conectados y configurados',
  'Respaldo de tu información antes de tocar nada',
];

const faq = [
  { q: '¿Los visitan en mi oficina o hay que llevar el equipo?', a: 'En Cali y área metropolitana vamos hasta allá. Si el arreglo necesita taller, lo coordinamos contigo con fecha de entrega clara.' },
  { q: '¿Puedo saber el precio antes?', a: 'Sí. El diagnóstico se cotiza primero; si hay repuestos, se cotizan aparte y se instala solo cuando tú apruebas el total.' },
  { q: '¿Y si el arreglo no vale la pena?', a: 'Te lo decimos claro. Preferimos perder un trabajo a venderte una reparación desperdiciada; si conviene un equipo nuevo, te orientamos con el presupuesto que tengas.' },
  { q: '¿Qué pasa con mis datos?', a: 'Se respaldan antes de intervenir. Si el disco está fallando, te lo decimos con anticipación antes de intentar el rescate de la información.' },
];
---

<Layout title={`${service.h1} | Sistek Pro`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Navbar client:load />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <div class={styles['service-hero-grid']}>
          <div>
            <h1>{service.h1}</h1>
            <p class={styles['service-hero-desc']}>{service.intro}</p>
            <div class={styles['service-hero-actions']}>
              <a href="/#contacto" class="btn-primary">
                Solicitar cotización
              </a>
              <a href={`tel:${datosEmpresa.telefonoIntl}`} class="btn-secondary">Llamar ahora</a>
            </div>
            <ul class={styles['service-hero-points']}>
              <li>Precio confirmado antes de abrir nada</li>
              <li>Respaldo de tus datos antes de la intervención</li>
              <li>Garantía del trabajo por escrito</li>
            </ul>
          </div>
          <figure class={styles['service-hero-photo']}>
            <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class={styles['service-cases-section']}>
      <div class="container">
        <h2>¿Te está pasando uno de estos?</h2>
        <p class={styles['service-cases-desc']}>Los mismos problemas de siempre para quienes dependen del equipo todos los días:</p>
        <ul class={styles['service-cases']}>
          {casos.map(c => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <section class={styles['service-steps-section']}>
      <div class="container">
        <h2>Cómo se resuelve un caso</h2>
        <ol class={styles['service-steps']}>
          {pasos.map((p, i) => (
            <li class={styles['service-step']}>
              <span class={styles['service-step-num']}>{i + 1}</span>
              <h3>{p.sub}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué cubre el soporte?</h2>
        <div class={styles['service-benefits-grid']}>
          <ul class={styles['service-cases']}>
            {incluye.map(item => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Lo que preguntan del soporte técnico</h2>
        {faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>

    <section class={styles['service-cta']}>
      <div class="container">
        <h2>¿Tu equipo necesita atención?</h2>
        <p>Cuéntanos qué pasa por WhatsApp o por el formulario y decides si se arregla en sitio o por remoto.</p>
        <div class={styles['service-cta-actions']}>
          <a href="/#contacto" class="btn-primary">
                Ir al formulario de contacto
              </a>
          <a href="/#servicios" class="btn-secondary">Ver otros servicios</a>
        </div>
        <p class={styles['service-cta-note']}>Atendemos Cali y el área metropolitana, presencial y a distancia en todo Colombia.</p>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
