---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';

const service = {
  name: 'Soporte Técnico Presencial y Remoto',
  slug: 'soporte-tecnico',
  description: 'Soporte técnico profesional en Cali. Atención presencial y remota para empresas y hogares. Diagnóstico, reparación y mantenimiento de equipos.',
  keywords: 'soporte técnico cali, asistencia técnica computadores, soporte remoto, soporte presencial, técnico computadores, reparación PC domicilio',
  h1: 'Soporte Técnico Profesional en Cali',
  intro: 'Asistencia técnica presencial y remota para empresas y hogares en Cali. Resolución rápida de problemas tecnológicos con profesionales capacitados.',
  benefits: [
    { title: 'Soporte presencial', desc: 'Visita técnica a tu ubicación en Cali y área metropolitana. Diagnóstico in situ y resolución de problemas de hardware y software.' },
    { title: 'Soporte remoto', desc: 'Asistencia remota inmediata para problemas de software, configuración y errores del sistema. Sin desplazamiento, más rápido y económico.' },
    { title: 'Planes de soporte', desc: 'Planes mensuales de soporte para empresas con atención prioritaria, visitas programadas y monitoreo preventivo.' },
    { title: 'Emergencias técnicas', desc: 'Atención urgente para fallas críticas que detienen tu operación. Respuesta rápida para minimizar el tiempo de inactividad.' },
  ],
  faq: [
    { q: '¿Cuánto tarda el soporte remoto?', a: 'El soporte remoto es inmediato. Una vez contactas, nos conectamos a tu equipo en minutos para diagnosticar y resolver el problema.' },
    { q: '¿Qué tipo de problemas resuelven?', a: 'Problemas de software, virus, errores del sistema, configuración de aplicaciones, impresoras, correos, redes y más.' },
    { q: '¿Tienen planes para empresas?', a: 'Sí, ofrecemos planes mensuales con soporte ilimitado, visitas programadas y atención prioritaria para empresas.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Soporte técnico"
};
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class={styles['service-hero-desc']}>{service.intro}</p>
        <div class={styles['service-hero-actions']}>
          <a href="/#contacto" class="btn-primary glow">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>
    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué incluye nuestro servicio?</h2>
        <div class={styles['service-benefits-grid']}>
          {service.benefits.map(b => (<div class={styles['service-benefit-card']}><h3>{b.title}</h3><p>{b.desc}</p></div>))}
        </div>
      </div>
    </section>
    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        {service.faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>
    <section class={styles['service-cta']}>
      <div class="container">
        <h2>¿Necesitas soporte técnico ahora?</h2>
        <p>Llámanos o escríbenos por WhatsApp. Atención inmediata para urgencias.</p>
        <a href="/#contacto" class="btn-primary glow">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>


