---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';

const service = {
  name: 'Soporte Técnico Presencial y Remoto',
  slug: 'soporte-tecnico',
  description: 'Soporte técnico en Cali. Presencial y remoto para empresas y hogares. Diagnóstico, reparación y mantenimiento de equipos.',
  keywords: 'soporte técnico cali, asistencia técnica computadores, soporte remoto, soporte presencial, técnico computadores, reparación PC domicilio',
  h1: 'Soporte Técnico en Cali',
  intro: 'Presencial o remoto. Resolvemos lo que otros no pudieron — o lo que nadie quiso tocar.',
  benefits: [
    { title: 'Presencial en Cali', desc: 'Visita técnica a tu ubicación. Diagnóstico in situ de hardware y software.' },
    { title: 'Remoto inmediato', desc: 'Nos conectamos a tu equipo en minutos. Más rápido, sin costo de desplazamiento.' },
    { title: 'Planes para empresas', desc: 'Mensual con atención prioritaria, visitas programadas y monitoreo preventivo.' },
    { title: 'Urgencias', desc: 'Fallaron las redes a las 3pm y cierran a 6? Venimos. Minimizamos tu tiempo caído.' },
  ],
  faq: [
    { q: '¿Qué tan rápido es el soporte remoto?', a: 'Nos contactás, nos conectamos y en minutos estamos diagnosticando. Sin desplazamiento.' },
    { q: '¿Qué arreglan?', a: 'Software, virus, errores del sistema, impresoras, correos, configuración de redes — todo lo que un equipo de oficina necesita.' },
    { q: '¿Tienen planes para empresas?', a: 'Sí. Planes mensuales con soporte ilimitado, visitas programadas y atención prioritaria.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Soporte técnico"
};
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class={styles['service-hero-desc']}>{service.intro}</p>
        <div class={styles['service-hero-actions']}>
          <a href="/#contacto" class="btn-primary">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>
    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué incluye?</h2>
        <div class={styles['service-benefits-grid']}>
          {service.benefits.map(b => (<div class={styles['service-benefit-card']}><h3>{b.title}</h3><p>{b.desc}</p></div>))}
        </div>
      </div>
    </section>
    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        {service.faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>
    <section class={styles['service-cta']}>
      <div class="container">
        <h2>¿Necesitás soporte ahora?</h2>
        <p>Llamá o escribinos por WhatsApp. Si es urgente, venimos.</p>
        <a href="/#contacto" class="btn-primary">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>


