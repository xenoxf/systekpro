---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';

const service = {
  name: 'Instalación de Redes Empresariales',
  slug: 'instalacion-redes-empresariales',
  description: 'Diseño e instalación de redes empresariales en Cali. Redes cableadas, switches, routers y configuración para empresas.',
  keywords: 'instalación redes empresariales cali, diseño redes corporativas, redes cableadas empresas, configuración switches routers, infraestructura de red',
  h1: 'Instalación de Redes Empresariales en Cali',
  intro: 'Diseñamos e instalamos tu red. Desde el diagnóstico hasta que todo funciona — sin excusas.',
  benefits: [
    { title: 'Diseño a medida', desc: 'Analizamos tu espacio y necesidades. Diseñamos la red que necesitás, no la que vendemos.' },
    { title: 'Cableado certificado', desc: 'Cableado CAT6/CAT6A, patch panels, racks. Todo certificado con reporte de pruebas.' },
    { title: 'Configuración de equipos', desc: 'Switches managed, routers, firewalls, VLANs. Seguridad y rendimiento desde el día uno.' },
    { title: 'Documentación completa', desc: 'Te entregamos diagramas, inventario, credenciales y manual de operación.' },
  ],
  faq: [
    { q: '¿Cuánto tarda?', a: 'Una oficina promedio: 2 a 5 días hábiles. Te damos el tiempo exacto después de la visita técnica.' },
    { q: '¿Con qué marcas trabajan?', a: 'Cisco, MikroTik, Ubiquiti, TP-Link y más. La que mejor se ajuste a tu presupuesto.' },
    { q: '¿Tiene garantía?', a: 'Sí. Garantía escrita en todo el trabajo. Si algo falla, volvemos.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Instalación de redes empresariales"
};
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class={styles['service-hero-desc']}>{service.intro}</p>
        <div class={styles['service-hero-actions']}>
          <a href="/#contacto" class="btn-primary">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>
    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué incluye?</h2>
        <div class={styles['service-benefits-grid']}>
          {service.benefits.map(b => (<div class={styles['service-benefit-card']}><h3>{b.title}</h3><p>{b.desc}</p></div>))}
        </div>
      </div>
    </section>
    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        {service.faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>
    <section class={styles['service-cta']}>
      <div class="container">
        <h2>¿Listo para instalar tu red?</h2>
        <p>Te asesoramos gratis. Sin compromiso.</p>
        <a href="/#contacto" class="btn-primary">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>


