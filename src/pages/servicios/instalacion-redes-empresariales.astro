---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';

const service = {
  name: 'Instalación de Redes Empresariales',
  slug: 'instalacion-redes-empresariales',
  description: 'Diseño e instalación profesional de redes empresariales en Cali. Redes cableadas, switches, routers y configuración completa para empresas e instituciones.',
  keywords: 'instalación redes empresariales cali, diseño redes corporativas, redes cableadas empresas, configuración switches routers, infraestructura de red',
  h1: 'Instalación de Redes Empresariales en Cali',
  intro: 'Diseñamos e instalamos redes empresariales de alto rendimiento. Soluciones integrales desde el diseño hasta la configuración final.',
  benefits: [
    { title: 'Diseño de red a medida', desc: 'Analizamos las necesidades de tu empresa y diseñamos una arquitectura de red optimizada para rendimiento, seguridad y escalabilidad.' },
    { title: 'Instalación de cableado', desc: 'Instalación profesional de cableado CAT6/CAT6A, patch panels, racks y canalización. Todo certificado y probado.' },
    { title: 'Configuración de equipos', desc: 'Configuración de switches managed, routers, firewalls y VLANs. Segmentación de red para seguridad y rendimiento.' },
    { title: 'Documentación completa', desc: 'Entregamos diagramas de red, inventario de equipos, credenciales de acceso y manual de operación.' },
  ],
  faq: [
    { q: '¿Cuánto tiempo toma instalar una red empresarial?', a: 'Dependiendo del tamaño y complejidad, una instalación de red para una oficina promedio toma de 2 a 5 días hábiles, incluyendo cableado, configuración y pruebas.' },
    { q: 'Qué marcas de equipos utilizan?', a: 'Trabajamos con Cisco, MikroTik, Ubiquiti, TP-Link y otras marcas líderes. Recomendamos la mejor opción según presupuesto y necesidades.' },
    { q: '¿La instalación incluye garantía?', a: 'Sí, todo nuestro trabajo cuenta con garantía. Incluimos soporte post-instalación para resolver cualquier inconveniente.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Instalación de redes empresariales"
};
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class={styles['service-hero-desc']}>{service.intro}</p>
        <div class={styles['service-hero-actions']}>
          <a href="/#contacto" class="btn-primary glow">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>
    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué incluye nuestro servicio?</h2>
        <div class={styles['service-benefits-grid']}>
          {service.benefits.map(b => (<div class={styles['service-benefit-card']}><h3>{b.title}</h3><p>{b.desc}</p></div>))}
        </div>
      </div>
    </section>
    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        {service.faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>
    <section class={styles['service-cta']}>
      <div class="container">
        <h2>¿Listo para instalar tu red empresarial?</h2>
        <p>Contáctanos y recibe asesoría gratuita para tu proyecto de red.</p>
        <a href="/#contacto" class="btn-primary glow">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>


