---
import Layout from '../../layouts/Layout.astro';

const service = {
  name: 'Configuración de Routers y Switches',
  slug: 'configuracion-routers-switches',
  description: 'Configuración profesional de routers, switches y access points en Cali. VLANs, QoS, seguridad de red y optimización de rendimiento.',
  keywords: 'configuración routers cali, configuración switches, VLANs, QoS, seguridad de red, MikroTik, Cisco, Ubiquiti',
  h1: 'Configuración de Routers y Switches en Cali',
  intro: 'Configuración experta de equipos de red para maximizar rendimiento, seguridad y estabilidad. Trabajamos con todas las marcas principales.',
  benefits: [
    { title: 'Configuración de routers', desc: 'Setup completo de routers con DHCP, NAT, port forwarding, DNS y reglas de firewall para máxima seguridad.' },
    { title: 'VLANs y segmentación', desc: 'Creación de redes virtuales para separar tráfico, mejorar seguridad y optimizar el rendimiento de tu red.' },
    { title: 'QoS y priorización', desc: 'Configuración de calidad de servicio para priorizar tráfico crítico como VoIP, videoconferencias y aplicaciones empresariales.' },
    { title: 'Seguridad perimetral', desc: 'Implementación de firewalls, filtrado de contenido, bloqueo de amenazas y políticas de acceso a la red.' },
  ],
  faq: [
    { q: '¿Qué marcas de routers configuran?', a: 'Configuramos MikroTik, Cisco, TP-Link, Ubiquiti, D-Link y otras marcas. También trabajamos con firmware alternativo como OpenWrt.' },
    { q: '¿Pueden mejorar mi red actual?', a: 'Sí, diagnosticamos tu red actual y proponemos mejoras de configuración para optimizar velocidad, cobertura y seguridad.' },
    { q: '¿Cuánto tiempo toma una configuración?', a: 'Una configuración básica toma 1-2 horas. Configuraciones avanzadas con VLANs y QoS pueden tomar medio día.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Configuración de routers y switches"
};
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class="service-page-hero">
      <div class="container">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class="service-hero-desc">{service.intro}</p>
        <div class="service-hero-actions">
          <a href="/#contacto" class="btn-primary glow">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>
    <section class="service-content">
      <div class="container">
        <h2>¿Qué incluye nuestro servicio?</h2>
        <div class="service-benefits-grid">
          {service.benefits.map(b => (<div class="service-benefit-card"><h3>{b.title}</h3><p>{b.desc}</p></div>))}
        </div>
      </div>
    </section>
    <section class="service-faq">
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        {service.faq.map(f => (<details class="faq-details"><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>
    <section class="service-cta">
      <div class="container">
        <h2>¿Tu red no funciona como debería?</h2>
        <p>Diagnóstico y configuración profesional para que tu red funcione al máximo.</p>
        <a href="/#contacto" class="btn-primary glow">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .service-page-hero { padding: 8rem 0 4rem; background: linear-gradient(135deg, hsl(var(--background)) 0%, hsl(var(--card)) 100%); }
  .breadcrumb ol { display: flex; gap: 0.5rem; list-style: none; padding: 0; margin-bottom: 2rem; font-size: 0.875rem; color: hsl(var(--muted-foreground)); }
  .breadcrumb li:not(:last-child)::after { content: '/'; margin-left: 0.5rem; }
  .breadcrumb a { color: hsl(var(--primary)); }
  .service-page-hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.025em; margin-bottom: 1.5rem; }
  .service-hero-desc { font-size: 1.25rem; color: hsl(var(--muted-foreground)); max-width: 600px; margin-bottom: 2rem; line-height: 1.6; }
  .service-hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .service-content { padding: 4rem 0; }
  .service-content h2 { font-size: 2rem; font-weight: 700; margin-bottom: 2rem; text-align: center; }
  .service-benefits-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .service-benefit-card { padding: 1.5rem; border-radius: var(--radius-2xl); border: 1px solid hsl(var(--border) / 0.5); background: hsl(var(--card) / 0.5); }
  .service-benefit-card h3 { font-size: 1.125rem; font-weight: 600; margin-bottom: 0.5rem; }
  .service-benefit-card p { color: hsl(var(--muted-foreground)); line-height: 1.6; }
  .service-faq { padding: 4rem 0; }
  .service-faq h2 { font-size: 2rem; font-weight: 700; margin-bottom: 2rem; text-align: center; }
  .faq-details { border: 1px solid hsl(var(--border) / 0.5); border-radius: var(--radius-lg); margin-bottom: 0.75rem; padding: 1rem 1.5rem; background: hsl(var(--card) / 0.3); }
  .faq-details summary { font-weight: 600; cursor: pointer; list-style: none; }
  .faq-details summary::-webkit-details-marker { display: none; }
  .faq-details p { margin-top: 0.75rem; color: hsl(var(--muted-foreground)); line-height: 1.6; }
  .service-cta { padding: 4rem 0; text-align: center; background: hsl(var(--card) / 0.3); }
  .service-cta h2 { font-size: 2rem; font-weight: 700; margin-bottom: 1rem; }
  .service-cta p { color: hsl(var(--muted-foreground)); margin-bottom: 2rem; font-size: 1.125rem; }
</style>
