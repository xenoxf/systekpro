---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';

const service = {
  name: 'Configuración de Routers y Switches',
  slug: 'configuracion-routers-switches',
  description: 'Configuración de routers, switches y access points en Cali. VLANs, QoS, seguridad y rendimiento.',
  keywords: 'configuración routers cali, configuración switches, VLANs, QoS, seguridad de red, MikroTik, Cisco, Ubiquiti',
  h1: 'Configuración de Routers y Switches en Cali',
  intro: 'Tu red está instalada pero no funciona bien? La configuramos para que rinda.',
  benefits: [
    { title: 'Routers', desc: 'DHCP, NAT, port forwarding, DNS, firewall. Seguridad desde la configuración.' },
    { title: 'VLANs', desc: 'Redes virtuales para separar tráfico. Seguridad y rendimiento.' },
    { title: 'QoS', desc: 'Priorizá VoIP, videoconferencias y apps críticas. Sin buffering en reuniones.' },
    { title: 'Seguridad', desc: 'Firewalls, filtrado de contenido, bloqueo de amenazas, políticas de acceso.' },
  ],
  faq: [
    { q: '¿Con qué marcas trabajan?', a: 'MikroTik, Cisco, TP-Link, Ubiquiti, D-Link y más. También OpenWrt.' },
    { q: '¿Pueden mejorar mi red actual?', a: 'Sí. Diagnosticamos y proponemos mejoras de configuración concretas.' },
    { q: '¿Cuánto tarda?', a: 'Básica: 1-2 horas. Avanzada con VLANs y QoS: medio día.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Configuración de routers y switches"
};
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class={styles['service-hero-desc']}>{service.intro}</p>
        <div class={styles['service-hero-actions']}>
          <a href="/#contacto" class="btn-primary">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>
    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué incluye?</h2>
        <div class={styles['service-benefits-grid']}>
          {service.benefits.map(b => (<div class={styles['service-benefit-card']}><h3>{b.title}</h3><p>{b.desc}</p></div>))}
        </div>
      </div>
    </section>
    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        {service.faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>
    <section class={styles['service-cta']}>
      <div class="container">
        <h2>Tu red no anda bien?</h2>
        <p>La diagnosticamos y la dejamos funcionando.</p>
        <a href="/#contacto" class="btn-primary">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>


