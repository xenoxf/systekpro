---
import Layout from '../../layouts/Layout.astro';

const service = {
  name: 'Mantenimiento de Computadores',
  slug: 'mantenimiento-computadores',
  description: 'Servicio profesional de mantenimiento preventivo y correctivo de computadores en Cali. Diagnóstico, reparación, limpieza y optimización de equipos de cómputo para empresas y hogares.',
  keywords: 'mantenimiento computadores cali, reparación pc cali, mantenimiento preventivo computadores, limpieza computadores, optimización equipos cómputo',
  h1: 'Mantenimiento de Computadores en Cali',
  intro: 'Mantenimiento profesional de computadores para empresas y hogares en Cali, Valle del Cauca. Servicio preventivo y correctivo con garantía.',
  benefits: [
    { title: 'Mantenimiento preventivo', desc: 'Limpieza interna y externa, cambio de pasta térmica, revisión de componentes y actualización de software para evitar fallas futuras.' },
    { title: 'Mantenimiento correctivo', desc: 'Diagnóstico y reparación de fallas de hardware y software. Reemplazo de componentes dañados con repuestos de calidad.' },
    { title: 'Optimización de rendimiento', desc: 'Eliminación de virus, malware y software innecesario. Optimización del sistema operativo para máxima velocidad.' },
    { title: 'Recuperación de datos', desc: 'Rescate de información de discos duros dañados o formateados. Backup y migración de datos a nuevos equipos.' },
  ],
  faq: [
    { q: '¿Cuánto tiempo toma un mantenimiento preventivo?', a: 'Un mantenimiento preventivo completo toma entre 1 y 3 horas dependiendo del estado del equipo. Incluye limpieza física, revisión de componentes y optimización de software.' },
    { q: '¿Cuánto cuesta el mantenimiento de un computador?', a: 'El costo varía según el tipo de mantenimiento y la cantidad de equipos. Ofrecemos precios competitivos y descuentos por volumen para empresas.' },
    { q: '¿Dan servicio a domicilio?', a: 'Sí, realizamos visitas a domicilio en Cali y área metropolitana. También ofrecemos servicio remoto para problemas de software.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Sistek",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Cali",
      "addressRegion": "Valle del Cauca",
      "addressCountry": "CO"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": "Cali"
  },
  "serviceType": "Mantenimiento de computadores",
  "category": "Servicios de tecnología"
};
---

<Layout
  title={`${service.h1} | Sistek Cali`}
  description={service.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main id="main" tabindex="-1">
    <section class="service-page-hero">
      <div class="container">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <ol>
            <li><a href="/">Inicio</a></li>
            <li><a href="/#servicios">Servicios</a></li>
            <li aria-current="page">{service.name}</li>
          </ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class="service-hero-desc">{service.intro}</p>
        <div class="service-hero-actions">
          <a href="/#contacto" class="btn-primary glow">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>

    <section class="service-content">
      <div class="container">
        <h2>¿Qué incluye nuestro servicio?</h2>
        <div class="service-benefits-grid">
          {service.benefits.map(b => (
            <div class="service-benefit-card">
              <h3>{b.title}</h3>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="service-faq">
      <div class="container">
        <h2>Preguntas frecuentes sobre {service.name.toLowerCase()}</h2>
        {service.faq.map(f => (
          <details class="faq-details">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="service-cta">
      <div class="container">
        <h2>¿Necesitas mantenimiento para tus equipos?</h2>
        <p>Contáctanos hoy y recibe una cotización sin compromiso. Atendemos en Cali y área metropolitana.</p>
        <a href="/#contacto" class="btn-primary glow">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .service-page-hero {
    padding: 8rem 0 4rem;
    background: linear-gradient(135deg, hsl(var(--background)) 0%, hsl(var(--card)) 100%);
  }
  .breadcrumb ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: hsl(var(--muted-foreground));
  }
  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
  }
  .breadcrumb a {
    color: hsl(var(--primary));
  }
  .service-page-hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: 1.5rem;
  }
  .service-hero-desc {
    font-size: 1.25rem;
    color: hsl(var(--muted-foreground));
    max-width: 600px;
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  .service-hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .service-content {
    padding: 4rem 0;
  }
  .service-content h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2rem;
    text-align: center;
  }
  .service-benefits-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .service-benefit-card {
    padding: 1.5rem;
    border-radius: var(--radius-2xl);
    border: 1px solid hsl(var(--border) / 0.5);
    background: hsl(var(--card) / 0.5);
  }
  .service-benefit-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .service-benefit-card p {
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
  }
  .service-faq {
    padding: 4rem 0;
  }
  .service-faq h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 2rem;
    text-align: center;
  }
  .faq-details {
    border: 1px solid hsl(var(--border) / 0.5);
    border-radius: var(--radius-lg);
    margin-bottom: 0.75rem;
    padding: 1rem 1.5rem;
    background: hsl(var(--card) / 0.3);
  }
  .faq-details summary {
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq-details summary::-webkit-details-marker { display: none; }
  .faq-details p {
    margin-top: 0.75rem;
    color: hsl(var(--muted-foreground));
    line-height: 1.6;
  }
  .service-cta {
    padding: 4rem 0;
    text-align: center;
    background: hsl(var(--card) / 0.3);
  }
  .service-cta h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .service-cta p {
    color: hsl(var(--muted-foreground));
    margin-bottom: 2rem;
    font-size: 1.125rem;
  }
</style>
