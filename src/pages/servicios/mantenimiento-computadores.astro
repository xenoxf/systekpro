---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';

const service = {
  name: 'Mantenimiento de Computadores',
  slug: 'mantenimiento-computadores',
  description: 'Mantenimiento preventivo y correctivo de computadores en Cali. Limpieza, diagnóstico, reparación y optimización.',
  keywords: 'mantenimiento computadores cali, reparación pc cali, mantenimiento preventivo computadores, limpieza computadores, optimización equipos cómputo',
  h1: 'Mantenimiento de Computadores en Cali',
  intro: 'Evitá las fallas antes de que te dejen tirado. Limpieza, diagnóstico y reparación con garantía.',
  benefits: [
    { title: 'Preventivo', desc: 'Limpieza, cambio de pasta térmica, revisión de componentes. Evitás las fallas futuras.' },
    { title: 'Correctivo', desc: 'Diagnóstico y reparación de hardware y software. Repuestos de calidad.' },
    { title: 'Optimización', desc: 'Eliminación de virus, software innecesario. Tu equipo vuelve a funcionar como nuevo.' },
    { title: 'Recuperación de datos', desc: 'Rescate de información de discos dañados. Backup y migración.' },
  ],
  faq: [
    { q: '¿Cuánto tarda un mantenimiento?', a: 'Entre 1 y 3 horas dependiendo del equipo. Incluye limpieza física, revisión y optimización.' },
    { q: '¿Cuánto cuesta?', a: 'Varía según el tipo y cantidad de equipos. Precios competitivos y descuentos por volumen.' },
    { q: '¿Van a domicilio?', a: 'Sí. Visitas en Cali y área metropolitana. También soporte remoto para software.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "Sistek",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Cali",
      "addressRegion": "Valle del Cauca",
      "addressCountry": "CO"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": "Cali"
  },
  "serviceType": "Mantenimiento de computadores",
  "category": "Servicios de tecnología"
};
---

<Layout
  title={`${service.h1} | Sistek Cali`}
  description={service.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol>
            <li><a href="/">Inicio</a></li>
            <li><a href="/#servicios">Servicios</a></li>
            <li aria-current="page">{service.name}</li>
          </ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class={styles['service-hero-desc']}>{service.intro}</p>
        <div class={styles['service-hero-actions']}>
          <a href="/#contacto" class="btn-primary">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>

    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué incluye?</h2>
        <div class={styles['service-benefits-grid']}>
          {service.benefits.map(b => (
            <div class={styles['service-benefit-card']}>
              <h3>{b.title}</h3>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Preguntas frecuentes sobre {service.name.toLowerCase()}</h2>
        {service.faq.map(f => (
          <details class={styles['faq-details']}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class={styles['service-cta']}>
      <div class="container">
        <h2>¿Necesitás mantenimiento?</h2>
        <p>Cotización sin compromiso. Atendemos en Cali y alrededores.</p>
        <a href="/#contacto" class="btn-primary">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>


