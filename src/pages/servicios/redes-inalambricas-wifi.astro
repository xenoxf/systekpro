---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';

const service = {
  name: 'Redes Inalámbricas WiFi Empresarial',
  slug: 'redes-inalambricas-wifi',
  description: 'Redes WiFi empresariales en Cali. Access points, cobertura total, roaming sin cortes.',
  keywords: 'wifi empresarial cali, instalación access points, cobertura wifi, red mesh, wifi oficina, wifi hotel, wifi restaurante',
  h1: 'Redes WiFi en Cali',
  intro: 'Cobertura sin puntos ciegos. Estudio de sitio, roaming sin cortes y soporte continuo.',
  benefits: [
    { title: 'Estudio de cobertura', desc: 'Mapeamos tu espacio. Ubicación óptima de APs para señal en todos lados.' },
    { title: 'APs empresariales', desc: 'Ubiquiti, Cisco, Aruba, TP-Link Omada. Soporte para cientos de dispositivos.' },
    { title: 'Mesh', desc: 'Para espacios grandes o difíciles. Señal sin pérdida de velocidad.' },
    { title: 'Portal cautivo', desc: 'Red para invitados con portal, límites y control de acceso.' },
  ],
  faq: [
    { q: '¿Cuántos APs necesito?', a: 'Depende del espacio, usuarios y materiales. Estudio de cobertura gratuito.' },
    { q: '¿Arreglan problemas de WiFi?', a: 'Sí. Cobertura, interferencia, velocidad, desconexiones. Soluciones definitivas.' },
    { q: '¿Para hoteles y restaurantes?', a: 'Sí. Portal cautivo, VLANs separadas, gestión de ancho de banda.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Redes WiFi empresariales"
};
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class={styles['service-hero-desc']}>{service.intro}</p>
        <div class={styles['service-hero-actions']}>
          <a href="/#contacto" class="btn-primary">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>
    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué incluye?</h2>
        <div class={styles['service-benefits-grid']}>
          {service.benefits.map(b => (<div class={styles['service-benefit-card']}><h3>{b.title}</h3><p>{b.desc}</p></div>))}
        </div>
      </div>
    </section>
    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        {service.faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>
    <section class={styles['service-cta']}>
      <div class="container">
        <h2>Tu WiFi no llega?</h2>
        <p>Estudio de cobertura gratuito y solución profesional.</p>
        <a href="/#contacto" class="btn-primary">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>


