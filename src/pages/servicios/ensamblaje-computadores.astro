---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';
import { IconBrandWhatsapp } from '@tabler/icons-react';

const service = {
  name: 'Ensamblaje de Computadores Personalizados',
  h1: 'Armamos el Computador que Necesitas en Cali',
  description: 'Ensamblaje de computadores personalizados en Cali según tu presupuesto y necesidades. Configuramos equipos para gaming, estudio, trabajo, programación, diseño y uso profesional.',
  image: '/evidencias/alguien_codeando.jpg',
  imageAlt: 'Computador de escritorio personalizado con sus componentes',
  intro: 'Los equipos de los clientes serán manipulados bajo rigurosas normas de protección física y electrostática (ESD). Se respetarán íntegramente las configuraciones originales de software y red del usuario, realizando cambios únicamente si han sido previamente autorizados.',
  waMsg: 'Hola Sistek, vengo de la página de Ensamblaje de Computadores. Quiero cotizar un equipo a mi medida.',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  provider: {
    '@type': 'LocalBusiness',
    name: 'Sistek',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Cali',
      addressRegion: 'Valle del Cauca',
      addressCountry: 'CO',
    },
  },
  areaServed: {
    '@type': 'City',
    name: 'Cali',
  },
  serviceType: 'Ensamblaje de computadores personalizados',
  category: 'Servicios de tecnología',
};

const pasos = [
  { sub: 'Uso y presupuesto', text: '¿Para jugar, estudiar, editar video, trabajar? Cuéntanos qué esperas ver y cuánto puedes invertir: eso define por dónde empieza el equipo.' },
  { sub: 'Propuesta de componentes', text: 'Te entregamos la configuración con alternativas: qué componente marca la diferencia y en cuál conviene ahorrar. Tú decides, sin presiones.' },
  { sub: 'Ensamblaje', text: 'Compramos por ti (o traes los componentes) y lo montamos: cableado limpio, pruebas de temperatura, RAM y discos verificados.' },
  { sub: 'Entrega lista', text: 'Se entrega funcionando: sistema, drivers y tus programas instalados si lo acuerdas. Con factura y condiciones de garantía explicadas.' },
];

const perfiles = [
  { title: 'Para jugar', desc: 'Configuramos según los títulos y la resolución que quieres probar: FPS reales, tarjeta gráfica, memoria y refrigeración acorde. Sin inflar el presupuesto con partes que no usas.' },
  { title: 'Para estudiar y trabajar', desc: 'Ofimática, clases, programación y multitarea. No todo equipo necesita tarjeta dedicada si el uso no la justifica, y eso se elige bien.' },
  { title: 'Para diseño y edición', desc: 'Edición de video, gráficos, modelado 3D y otras tareas exigentes: cada componente se elige por carga de trabajo, no por marketing.' },
  { title: 'Reutilizar lo que sirve', desc: 'Si tienes componentes de tu computador anterior, los revisamos: cuáles sirven, cuáles conviene actualizar y cuáles quedarse.' },
];

const incluye = [
  'Verificación de compatibilidad entre procesador, placa, memoria, gráfica, fuente y gabinete',
  'Montaje con cableado ordenado, algo que se agradece el día que hay que abrir el equipo',
  'Pruebas de temperatura, memoria y discos antes de la entrega',
  'Sistema operativo y drivers instalados, con tus programas si lo acuerdas',
  'Factura por componente y condiciones de garantía definidas en la cotización',
];

const faq = [
  {
    q: '¿Puedo armar un computador con mi presupuesto?',
    a: 'Sí. Sin importar si es un presupuesto corto o holgado, te proponemos la configuración que rinde más por tu rango. Se aclara dónde conviene invertir más y dónde no.',
  },
  {
    q: '¿Puedo elegir los componentes?',
    a: 'Sí. Nos dices qué prefieres o pedimos una propuesta completa; antes de ensamblar revisamos que todo sea compatible entre sí.',
  },
  {
    q: '¿Solo para gaming?',
    a: 'No, ese es solo el perfil más público. Armamos para estudio, programación, ofimática, diseño, edición y servidores ligeros. Cada uso tiene su configuración distinta.',
  },
  {
    q: '¿El precio incluye los componentes?',
    a: 'La cotización divide el valor de los componentes, el ensamblaje y lo adicional. Sin irnos a vender el computador más caro del menú, sino el que te sirve.',
  },
  {
    q: '¿Puedo reutilizar componentes de mi equipo anterior?',
    a: 'Sí, es común. Los evaluamos: cuáles siguen sirviendo, cuáles conviene actualizar y cuáles conviene retirar.',
  },
  {
    q: '¿Qué garantía tiene el computador?',
    a: 'Las condiciones se especifican en la cotización antes de confirmar el servicio: garantía del ensamblaje y de cada componente según su proveedor.',
  },
];
---

<Layout
  title={`${service.h1} | Sistek Cali`}
  description={service.description}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol>
            <li><a href="/">Inicio</a></li>
            <li><a href="/#servicios">Servicios</a></li>
            <li aria-current="page">{service.name}</li>
          </ol>
        </nav>

        <div class={styles['service-hero-grid']}>
          <div>
            <h1>{service.h1}</h1>
            <p class={styles['service-hero-desc']}>
              {service.intro}
            </p>

            <div class={styles['service-hero-actions']}>
              <a href={`https://wa.me/573175000509?text=${encodeURIComponent(service.waMsg)}`} class={styles['wa-btn']} target="_blank" rel="noopener noreferrer">
                <IconBrandWhatsapp aria-hidden="true" />
                Cotizar mi computador
              </a>
              <a href="tel:+571234513541" class="btn-secondary">
                Llamar ahora
              </a>
            </div>
            <ul class={styles['service-hero-points']}>
              <li>Cotización separada: componentes, ensamblaje y extras</li>
              <li>Se puede reutilizar parte del equipo que ya tienes</li>
              <li>Factura y garantía definidas antes de comprar nada</li>
            </ul>
          </div>

          <figure class={styles['service-hero-photo']}>
            <img
              src={service.image}
              alt={service.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class={styles['service-steps-section']}>
      <div class="container">
        <h2>De la idea al equipo encendido</h2>
        <ol class={styles['service-steps']}>
          {pasos.map((p, i) => (
            <li class={styles['service-step']}>
              <span class={styles['service-step-num']}>{i + 1}</span>
              <h3>{p.sub}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class={styles['service-content']}>
      <div class="container">
        <h2>Cada perfil usa el componente del que necesita</h2>
        <p>
          No todos los computadores son lo mismo y aquí no hay "paquete
          gamer" de exhibición. La configuración sale del uso concreto
          que le vas a dar, no del más vendido del catálogo.
        </p>

        <div class={styles['service-benefits-grid']}>
          {perfiles.map((benefit) => (
            <article class={styles['service-benefit-card']}>
              <h3>{benefit.title}</h3>
              <p>{benefit.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class={styles['service-cases-section']}>
      <div class="container">
        <h2>¿Qué entra en el servicio?</h2>
        <ul class={styles['service-cases']}>
          {incluye.map(item => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class={styles['service-faq']}>
      <div class="container">
        <h2>
          Preguntas frecuentes sobre computadores personalizados
        </h2>

        {faq.map((item) => (
          <details class={styles['faq-details']}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class={styles['service-cta']}>
      <div class="container">
        <h2>Cuéntanos qué computador quieres armar</h2>
        <p>
          Dinos tu presupuesto, para qué vas a utilizar el equipo
          y qué rendimiento esperas. Te ayudaremos a encontrar
          una configuración que se ajuste a ti.
        </p>
        <div class={styles['service-cta-actions']}>
          <a href={`https://wa.me/573175000509?text=${encodeURIComponent(service.waMsg)}`} class={styles['wa-btn']} target="_blank" rel="noopener noreferrer">
            <IconBrandWhatsapp aria-hidden="true" />
            Escribir por WhatsApp
          </a>
          <a href="/#servicios" class="btn-secondary">
            Ver otros servicios
          </a>
        </div>
        <p class={styles['service-cta-note']}>Atendemos Cali y el área metropolitana.</p>
      </div>
    </section>
  </main>
</Layout>
