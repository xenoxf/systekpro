---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';
import { IconBrandWhatsapp } from '@tabler/icons-react';

const service = {
  name: 'Asistencia técnica remota inmediata',
  h1: 'Asistencia Técnica Remota en Cali',
  description: 'Asistencia técnica remota en Cali: nos conectamos a tus equipos en minutos por acceso seguro. Software, impresoras, correo y red sin desplazamiento.',
  keywords: 'asistencia técnica remota cali, soporte remoto computadores, ayuda urgente computador, soporte remoto empresas',
  image: '/evidencias/redes_trabajando.jpg',
  imageAlt: 'Asistencia técnica remota por computador',
  intro: 'SISTEK PRO garantiza la estricta reserva y protección de los datos de sus clientes. El personal técnico aplicará protocolos de seguridad en cada intervención y respaldos temporales estrictamente autorizados.',
  waMsg: 'Hola Sistek, vengo de la página de Asistencia Remota. Tengo un problema y quiero resolverlo hoy mismo.',
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Asistencia técnica remota"
};

const casos = [
  'El equipo de caja tarda una eternidad en abrir el sistema',
  'El Outlook pide la contraseña cada cinco minutos',
  'La impresora de red desapareció y nadie sabe por qué',
  'Alguien abrió un archivo "raro" y el equipo anda lento',
  'El wifi cae a ciertas horas y nadie encuentra el patrón',
  'Hay que instalar un programa nuevo y no hay técnico disponible esta semana',
];

const pasos = [
  { sub: 'Cuéntanos en dos líneas', text: 'Escribe el problema por WhatsApp, con nombre del equipo y cuándo empezó. Si es resolvible en remoto, coordinamos la sesión en el momento.' },
  { sub: 'Apruebas la conexión', text: 'Te enviamos un enlace de sesión remota: tú lo aceptas, ves todo lo que hacemos en tu pantalla y puedes cortar cuando quieras.' },
  { sub: 'Resolvemos contigo viendo', text: 'Arrancamos sobre tu equipo sin bloquear tu teclado. Si el caso necesita pieza o presencia física, se agenda la visita presencial.' },
  { sub: 'Cierra con reporte', text: 'Te enviamos por escrito qué se hizo y qué conviene para que no vuelva. El registro queda disponible si tu auditoría lo pide.' },
];

const incluye = [
  'Windows y programas corriendo de nuevo: virus, errores raros, correo, Office y software de oficina',
  'Impresoras en red, escáneres y periféricos conectados de nuevo',
  'Sesiones cifradas con tu autorización y registro de cada atención',
  'Prioridad de atención y horas incluidas para clientes con plan mensual',
];

const faq = [
  { q: '¿Qué tan rápido atienden?', a: 'En horario laboral solemos conectar en minutos. Si hay cola por otros clientes, te decimos la hora exacta de atención; urgencias con visita presencial se coordinan el mismo día si el horario lo permite.' },
  { q: '¿Es seguro dar acceso a mi equipo?', a: 'La sesión va cifrada, se abre solo con tu aprobación, la ves en pantalla y se cierra al terminar. Queda registro de todo lo que se tocó.' },
  { q: '¿Y si el problema no es de software?', a: 'Se descuenta del caso lo que se pueda resolver en remoto y se agenda la visita presencial con el mismo técnico que te atendió. No cobramos doble.' },
  { q: '¿Cómo se cobra?', a: 'Por evento, o con plan mensual si tu empresa necesita soporte constante: el plan incluye horas y prioridad. Cotización antes de conectarnos.' },
];
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <div class={styles['service-hero-grid']}>
          <div>
            <h1>{service.h1}</h1>
            <p class={styles['service-hero-desc']}>{service.intro}</p>
            <div class={styles['service-hero-actions']}>
              <a href={`https://wa.me/573175000509?text=${encodeURIComponent(service.waMsg)}`} class={styles['wa-btn']} target="_blank" rel="noopener noreferrer">
                <IconBrandWhatsapp aria-hidden="true" />
                Pedir asistencia ya
              </a>
              <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
            </div>
            <ul class={styles['service-hero-points']}>
              <li>Sesión visible en tu pantalla: nada se toca a ciegas</li>
              <li>Registro escrito de cada atención</li>
              <li>Si el caso requiere visita, el mismo técnico la agenda</li>
            </ul>
          </div>
          <figure class={styles['service-hero-photo']}>
            <img src={service.image} alt={service.imageAlt} loading="lazy" decoding="async" />
          </figure>
        </div>
      </div>
    </section>

    <section class={styles['service-cases-section']}>
      <div class="container">
        <h2>Son los casos que llegan todos los días</h2>
        <p class={styles['service-cases-desc']}>Si estás viviendo alguno de estos, probablemente este servicio lo resuelve hoy mismo:</p>
        <ul class={styles['service-cases']}>
          {casos.map(c => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <section class={styles['service-steps-section']}>
      <div class="container">
        <h2>Cómo es una sesión</h2>
        <ol class={styles['service-steps']}>
          {pasos.map((p, i) => (
            <li class={styles['service-step']}>
              <span class={styles['service-step-num']}>{i + 1}</span>
              <h3>{p.sub}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué entra en el servicio?</h2>
        <div class={styles['service-benefits-grid']}>
          <ul class={styles['service-cases']}>
            {incluye.map(item => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Lo más preguntado</h2>
        {faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>

    <section class={styles['service-cta']}>
      <div class="container">
        <h2>¿Te está pasando ahora mismo?</h2>
        <p>Tu mejor opción es WhatsApp: recibimos el caso al momento y, si toca remoto, empezamos hoy mismo. No llenes formularios si el equipo está trancado justo ahora.</p>
        <div class={styles['service-cta-actions']}>
          <a href={`https://wa.me/573175000509?text=${encodeURIComponent(service.waMsg)}`} class={styles['wa-btn']} target="_blank" rel="noopener noreferrer">
            <IconBrandWhatsapp aria-hidden="true" />
            Escribir por WhatsApp
          </a>
          <a href="/#servicios" class="btn-secondary">Ver otros servicios</a>
        </div>
        <p class={styles['service-cta-note']}>Atención para todo Colombia por remoto; en sitio, Cali y el área metropolitana.</p>
      </div>
    </section>
  </main>
</Layout>
