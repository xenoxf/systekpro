---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';

const service = {
  name: 'Cableado Estructurado',
  slug: 'cableado-estructurado',
  description: 'Instalación profesional de cableado estructurado CAT6 y CAT6A en Cali. Racks, patch panels, rostros de red y certificación de puntos.',
  keywords: 'cableado estructurado cali, instalación CAT6, cableado red empresarial, patch panels, racks de red, certificación cableado',
  h1: 'Cableado Estructurado Profesional en Cali',
  intro: 'Instalación y certificación de cableado estructurado para empresas, oficinas e instituciones educativas. Soluciones CAT6 y CAT6A con garantía.',
  benefits: [
    { title: 'Cableado CAT6 / CAT6A', desc: 'Instalación de cable de alta categoría para velocidades de hasta 10 Gbps. Ideal para redes empresariales de alto rendimiento.' },
    { title: 'Racks y patch panels', desc: 'Organización profesional de racks de comunicaciones, patch panels y gestión de cables para un centro de datos ordenado.' },
    { title: 'Rostros de red y outlets', desc: 'Instalación de puntos de red en oficinas, salas y áreas de trabajo. Acabados limpios y profesionales.' },
    { title: 'Certificación de puntos', desc: 'Pruebas de certificación con equipo profesional. Entregamos reporte de rendimiento de cada punto instalado.' },
  ],
  faq: [
    { q: '¿Qué diferencia hay entre CAT6 y CAT6A?', a: 'CAT6 soporta velocidades de hasta 1 Gbps a 100 metros y 10 Gbps a 55 metros. CAT6A soporta 10 Gbps a 100 metros completos. Para nuevas instalaciones recomendamos CAT6A.' },
    { q: '¿Cuántos puntos de red puedo instalar?', a: 'No hay límite. Instalamos desde un punto hasta cientos de puntos en edificios completos. Cada proyecto se cotiza según necesidades.' },
    { q: '¿Entregan certificación del cableado?', a: 'Sí, cada punto se prueba con equipo certificado y se entrega un reporte con los resultados de la prueba.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Cableado estructurado"
};
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class={styles['service-hero-desc']}>{service.intro}</p>
        <div class={styles['service-hero-actions']}>
          <a href="/#contacto" class="btn-primary glow">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>
    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué incluye nuestro servicio?</h2>
        <div class={styles['service-benefits-grid']}>
          {service.benefits.map(b => (<div class={styles['service-benefit-card']}><h3>{b.title}</h3><p>{b.desc}</p></div>))}
        </div>
      </div>
    </section>
    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        {service.faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>
    <section class={styles['service-cta']}>
      <div class="container">
        <h2>¿Necesitas cableado estructurado?</h2>
        <p>Solicita una visita técnica sin costo y recibe una cotización detallada.</p>
        <a href="/#contacto" class="btn-primary glow">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>


