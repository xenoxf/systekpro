---
import Layout from '../../layouts/Layout.astro';
import styles from '@/styles/ServicePage.module.css';

const service = {
  name: 'Cableado Estructurado',
  slug: 'cableado-estructurado',
  description: 'Instalación de cableado estructurado CAT6 y CAT6A en Cali. Racks, patch panels, rostros y certificación.',
  keywords: 'cableado estructurado cali, instalación CAT6, cableado red empresarial, patch panels, racks de red, certificación cableado',
  h1: 'Cableado Estructurado en Cali',
  intro: 'Cableado que funciona. CAT6/CAT6A, racks, patch panels — todo certificado con reporte.',
  benefits: [
    { title: 'CAT6 / CAT6A', desc: 'Cableado de alta categoría. Velocidades de hasta 10 Gbps para redes que no se queden cortas.' },
    { title: 'Racks y patch panels', desc: 'Organización profesional. Centro de datos ordenado y mantenible.' },
    { title: 'Rostros y outlets', desc: 'Puntos de red en cada área de trabajo. Acabados limpios.' },
    { title: 'Certificación', desc: 'Pruebas con equipo profesional. Te entregamos el reporte de cada punto.' },
  ],
  faq: [
    { q: '¿CAT6 o CAT6A?', a: 'CAT6: hasta 1 Gbps a 100m, 10 Gbps a 55m. CAT6A: 10 Gbps a 100m completos. Para nuevas instalaciones, recomendamos CAT6A.' },
    { q: '¿Cuántos puntos puedo instalar?', a: 'No hay límite. Desde un punto hasta cientos en un edificio completo.' },
    { q: '¿Entregan certificación?', a: 'Sí. Cada punto se prueba con equipo certificado y te damos el reporte.' },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@type": "LocalBusiness", "name": "Sistek" },
  "areaServed": { "@type": "City", "name": "Cali" },
  "serviceType": "Cableado estructurado"
};
---

<Layout title={`${service.h1} | Sistek Cali`} description={service.description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" tabindex="-1">
    <section class={styles['service-page-hero']}>
      <div class="container">
        <nav aria-label="Breadcrumb" class={styles.breadcrumb}>
          <ol><li><a href="/">Inicio</a></li><li><a href="/#servicios">Servicios</a></li><li aria-current="page">{service.name}</li></ol>
        </nav>
        <h1>{service.h1}</h1>
        <p class={styles['service-hero-desc']}>{service.intro}</p>
        <div class={styles['service-hero-actions']}>
          <a href="/#contacto" class="btn-primary">Solicitar cotización</a>
          <a href="tel:+571234513541" class="btn-secondary">Llamar ahora</a>
        </div>
      </div>
    </section>
    <section class={styles['service-content']}>
      <div class="container">
        <h2>¿Qué incluye?</h2>
        <div class={styles['service-benefits-grid']}>
          {service.benefits.map(b => (<div class={styles['service-benefit-card']}><h3>{b.title}</h3><p>{b.desc}</p></div>))}
        </div>
      </div>
    </section>
    <section class={styles['service-faq']}>
      <div class="container">
        <h2>Preguntas frecuentes</h2>
        {service.faq.map(f => (<details class={styles['faq-details']}><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </div>
    </section>
    <section class={styles['service-cta']}>
      <div class="container">
        <h2>¿Necesitás cableado?</h2>
        <p>Visita técnica sin costo. Te cotizamos detallado.</p>
        <a href="/#contacto" class="btn-primary">Solicitar servicio</a>
      </div>
    </section>
  </main>
</Layout>


