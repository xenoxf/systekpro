---
import { IconSearch, IconClipboardList, IconSettings, IconTestPipe, IconHeartHandshake } from '@tabler/icons-react';
import styles from "@/styles/Process.module.css";
---

<section id="proceso">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Cómo <span class="gradient-text">trabajamos</span></h2>
      <p class="section-desc">Un proceso claro, profesional y eficiente para garantizar resultados en cada proyecto.</p>
    </div>

    <div class={styles['process-line']}></div>

    <ol class={styles['process-grid']}>
      <li class={styles['process-step']}>
        <div class={`${styles['process-step-icon']} ${styles.primary}`} aria-hidden="true">
          <IconSearch />
        </div>
        <div class={`${styles['process-step-number']} ${styles.primary}`} aria-hidden="true">1</div>
        <h3 class={styles['process-step-title']}>Diagnóstico</h3>
        <p class={styles['process-step-desc']}>Evaluamos tu infraestructura actual e identificamos oportunidades de mejora.</p>
      </li>

      <li class={styles['process-step']}>
        <div class={`${styles['process-step-icon']} ${styles.accent}`} aria-hidden="true">
          <IconClipboardList />
        </div>
        <div class={`${styles['process-step-number']} ${styles.accent}`} aria-hidden="true">2</div>
        <h3 class={styles['process-step-title']}>Propuesta</h3>
        <p class={styles['process-step-desc']}>Diseñamos una solución a la medida con alcance, tiempos y presupuesto transparente.</p>
      </li>

      <li class={styles['process-step']}>
        <div class={`${styles['process-step-icon']} ${styles.primary}`} aria-hidden="true">
          <IconSettings />
        </div>
        <div class={`${styles['process-step-number']} ${styles.primary}`} aria-hidden="true">3</div>
        <h3 class={styles['process-step-title']}>Implementación</h3>
        <p class={styles['process-step-desc']}>Ejecutamos la solución con personal capacitado y mínima interrupción de operaciones.</p>
      </li>

      <li class={styles['process-step']}>
        <div class={`${styles['process-step-icon']} ${styles.accent}`} aria-hidden="true">
          <IconTestPipe />
        </div>
        <div class={`${styles['process-step-number']} ${styles.accent}`} aria-hidden="true">4</div>
        <h3 class={styles['process-step-title']}>Pruebas</h3>
        <p class={styles['process-step-desc']}>Verificamos cada punto de la instalación con pruebas de rendimiento y funcionamiento.</p>
      </li>

      <li class={styles['process-step']}>
        <div class={`${styles['process-step-icon']} ${styles.primary}`} aria-hidden="true">
          <IconHeartHandshake />
        </div>
        <div class={`${styles['process-step-number']} ${styles.primary}`} aria-hidden="true">5</div>
        <h3 class={styles['process-step-title']}>Soporte continuo</h3>
        <p class={styles['process-step-desc']}>Acompañamiento continuo para garantizar que todo funcione correctamente.</p>
      </li>
    </ol>
  </div>
</section>
