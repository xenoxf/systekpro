---
import styles from "@/styles/Process.module.css";
---

<section id="proceso" class={styles['proceso']} aria-labelledby="proceso-heading">
  <div class={styles['proceso-inner']}>
    <header class={styles['proceso-header']}>
      <h2 id="proceso-heading" class={styles['proceso-title']}>Proceso</h2>
      <p class={styles['proceso-desc']}>
        Así organizamos cada trabajo, de la primera llamada a la entrega.
      </p>
    </header>

    <div class={styles['process-steps']}>
      <article class={styles['step']}>
        <figure class={styles['step-media']}>
          <img
            src="/evidencias/marketing_work.jpg"
            alt="Equipo de Sistek Pro atendiendo la solicitud de un cliente"
            class={styles['step-img']}
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class={styles['step-body']}>
          <div class={styles['step-heading']}>
            <span class={styles['step-num']} aria-hidden="true">01</span>
            <h3 class={styles['step-title']}>Solicitud</h3>
          </div>
          <p class={styles['step-desc']}>
            Nos cuentas qué necesitas y cómo trabaja tu empresa.
          </p>
        </div>
      </article>

      <article class={styles['step']}>
        <figure class={styles['step-media']}>
          <img
            src="/evidencias/mantenimiento_pc.jpg"
            alt="Técnico de Sistek Pro diagnosticando un computador"
            class={styles['step-img']}
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class={styles['step-body']}>
          <div class={styles['step-heading']}>
            <span class={styles['step-num']} aria-hidden="true">02</span>
            <h3 class={styles['step-title']}>Diagnóstico</h3>
          </div>
          <p class={styles['step-desc']}>
            Revisamos tu infraestructura y definimos la solución.
          </p>
        </div>
      </article>

      <article class={styles['step']}>
        <figure class={styles['step-media']}>
          <img
            src="/evidencias/redes_trabajando.jpg"
            alt="Instalación y configuración de equipos de red en sitio"
            class={styles['step-img']}
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class={styles['step-body']}>
          <div class={styles['step-heading']}>
            <span class={styles['step-num']} aria-hidden="true">03</span>
            <h3 class={styles['step-title']}>Ejecución</h3>
          </div>
          <p class={styles['step-desc']}>
            Instalamos, configuramos y probamos todo contigo. Si tu equipo va
            a usarlo, lo dejamos capacitado antes de irnos.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
