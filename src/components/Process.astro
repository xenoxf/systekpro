---
import styles from "@/styles/Process.module.css";
---

<section id="proceso" class={styles['proceso']}>
  <div class={styles['proceso-inner']}>
    <div class={styles['proceso-header']}>
      <h2 class={styles['proceso-title']}>Proceso</h2>
    </div>

    <div class={styles['process-steps']}>
      <div class={styles['step']}>
        <span class={styles['step-num']}>01</span>
        <h3 class={styles['step-title']}>SOLICITUD</h3>
        <div class={styles['step-line']}></div>
        <p class={styles['step-desc']}>Conocemos tu necesidad.</p>
      </div>

      <div class={styles['step']}>
        <span class={styles['step-num']}>02</span>
        <h3 class={styles['step-title']}>DIAGNÓSTICO</h3>
        <div class={styles['step-line']}></div>
        <p class={styles['step-desc']}>Evaluamos la situación.</p>
      </div>

      <div class={styles['step']}>
        <span class={styles['step-num']}>03</span>
        <h3 class={styles['step-title']}>EJECUCIÓN</h3>
        <div class={styles['step-line']}></div>
        <p class={styles['step-desc']}>Implementamos la solución.</p>
      </div>
    </div>

    <div class={styles['carousel']}>
      <div class={styles['carousel-slide']}><img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?w=1200&q=80&auto=format&fit=crop" alt="Instalación de infraestructura tecnológica" class={styles['carousel-img']} /></div>
      <div class={styles['carousel-slide']}><img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1200&q=80&auto=format&fit=crop" alt="Cableado estructurado de red" class={styles['carousel-img']} /></div>
      <div class={styles['carousel-slide']}><img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1200&q=80&auto=format&fit=crop" alt="Configuración de equipos de red" class={styles['carousel-img']} /></div>
      <div class={styles['carousel-slide']}><img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=1200&q=80&auto=format&fit=crop" alt="Soporte técnico especializado" class={styles['carousel-img']} /></div>
    </div>
  </div>
</section>
