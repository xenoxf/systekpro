---
import styles from "@/styles/Services.module.css";

const list = [
  { href: "/servicios/mantenimiento-computadores", title: "Mantenimiento preventivo y correctivo de equipos de cómputo", desc: "Limpieza, diagnóstico, reparación y optimización." },
  { href: "/servicios/instalacion-redes-empresariales", title: "Diseño e instalación de redes empresariales cableadas", desc: "Redes cableadas para oficinas, colegios y bodegas." },
  { href: "/servicios/cableado-estructurado", title: "Cableado estructurado certificado CAT6 y CAT6A", desc: "Patch panels, racks y reporte de pruebas." },
  { href: "/servicios/configuracion-routers-switches", title: "Configuración de routers, switches y equipos de red", desc: "VLANs, QoS, VPN y red documentada." },
  { href: "/servicios/soporte-tecnico", title: "Soporte técnico para empresas y hogares", desc: "Diagnóstico y reparación, presencial en Cali y a distancia." },
  { href: "/servicios/asistencia-remota", title: "Asistencia técnica remota inmediata", desc: "Respuesta en menos de 2 horas por acceso seguro." },
  { href: "/servicios/diseno-mantenimiento-redes-datos", title: "Diseño y mantenimiento de redes de datos", desc: "Plan, instalación, visitas programadas y ampliación." },
  { href: "/servicios/desarrollo-web-backend", title: "Desarrollo y mantenimiento web con backend", desc: "Sitios, backend, bases de datos y mantenimiento." },
];
---

<section id="servicios">
  <div class="container2">
    <div class="section-header">
      <h2 class="section-title">Lo que hacemos en Cali</h2>
      <p class="section-desc">Cada servicio lo ejecuta personal de Sistek con precio cerrado y garantía escrita.</p>
    </div>

    <div class={styles['servicios-grid']}>
      {list.map(s => (
        <a href={s.href} class={styles['service-card']}>
          <h3 class={styles['service-card-title']}>{s.title}</h3>
          <p class={styles['service-card-desc']}>{s.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>
