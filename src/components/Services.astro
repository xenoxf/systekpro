---
import { IconDeviceLaptop, IconNetwork, IconCpu, IconRouter, IconHeadset, IconWifi } from '@tabler/icons-react';
import styles from "@/styles/Services.module.css";
---

<section id="servicios">
  <div class={styles['servicios-bg']}></div>
  <div class="container2">
    <div class="section-header">
      <h2 class="section-title">Soluciones tecnológicas <span class="gradient-text">profesionales</span></h2>
      <p class="section-desc">Ofrecemos servicios integrales de infraestructura tecnológica para empresas que exigen calidad, confianza y rendimiento.</p>
    </div>

    <div class={styles['servicios-grid']}>
      <a href="#contacto" class={styles['service-card']}>
        <div class={`${styles['service-card-icon']} ${styles.primary}`} aria-hidden="true"><IconDeviceLaptop /></div>
        <h3 class={styles['service-card-title']}>Mantenimiento de equipos</h3>
        <p class={styles['service-card-desc']}>Diagnóstico, reparación y optimización de computadores. Mantenimiento preventivo y correctivo para maximizar la vida útil de tus equipos.</p>
      </a>

      <a href="#contacto" class={styles['service-card']}>
        <div class={`${styles['service-card-icon']} ${styles.accent}`} aria-hidden="true"><IconNetwork /></div>
        <h3 class={styles['service-card-title']}>Instalación de redes</h3>
        <p class={styles['service-card-desc']}>Diseño e implementación de redes cableadas e inalámbricas para empresas e instituciones con los más altos estándares de calidad.</p>
      </a>

      <a href="#contacto" class={styles['service-card']}>
        <div class={`${styles['service-card-icon']} ${styles.primary}`} aria-hidden="true"><IconCpu /></div>
        <h3 class={styles['service-card-title']}>Cableado estructurado</h3>
        <p class={styles['service-card-desc']}>Instalación profesional de cableado, patch panels y racks. Organización y certificación de redes para máximo rendimiento.</p>
      </a>

      <a href="#contacto" class={styles['service-card']}>
        <div class={`${styles['service-card-icon']} ${styles.accent}`} aria-hidden="true"><IconRouter /></div>
        <h3 class={styles['service-card-title']}>Configuración de equipos</h3>
        <p class={styles['service-card-desc']}>Configuración profesional de routers, switches y access points. Optimización de redes para negocios y hogares.</p>
      </a>

      <a href="#contacto" class={styles['service-card']}>
        <div class={`${styles['service-card-icon']} ${styles.accent}`} aria-hidden="true"><IconWifi /></div>
        <h3 class={styles['service-card-title']}>Redes inalámbricas</h3>
        <p class={styles['service-card-desc']}>Implementación de redes WiFi con cobertura óptima, instalación de access points y solución de problemas de conectividad.</p>
      </a>

      <a href="#contacto" class={styles['service-card']}>
        <div class={`${styles['service-card-icon']} ${styles.primary}`} aria-hidden="true"><IconHeadset /></div>
        <h3 class={styles['service-card-title']}>Soporte técnico</h3>
        <p class={styles['service-card-desc']}>Asistencia técnica presencial y remota. Diagnóstico de fallas, instalación de software y solución de problemas tecnológicos.</p>
      </a>
    </div>
  </div>
</section>
