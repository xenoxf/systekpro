---
import {
    IconBrandTwitter,
    IconBrandLinkedin,
    IconBrandInstagram,
    IconBrandFacebook,
    IconArrowUp,
} from "@tabler/icons-react";
import styles from "@/styles/Footer.module.css";
---

<footer class={styles.footer}>
    <div class={styles['footer-inner']}>
        <div class={styles['footer-grid']}>
            <div class={styles['footer-brand']}>
                <a href="/" class={styles['footer-logo']} aria-label="Sistek - Inicio">
                    <img
                        src="/logo.png"
                        alt="Sistek logo"
                        class={styles['logo-light']}
                    />
                    <img
                        src="/logo_white.png"
                        alt="Sistek logo"
                        class={styles['logo-dark']}
                    />
                </a>
                <p class={styles['footer-desc']}>
                    Infraestructura tecnológica, redes empresariales y soporte
                    técnico profesional en Cali, Colombia. Transformamos tu
                    tecnología para impulsar tu negocio.
                </p>
            </div>

            <div>
                <h3 class={styles['footer-heading']}>Servicios</h3>
                <ul class={styles['footer-links']}>
                    <li>
                        <a href="/servicios/mantenimiento-computadores"
                            >Mantenimiento de equipos</a>
                    </li>
                    <li>
                        <a href="/servicios/instalacion-redes-empresariales"
                            >Instalación de redes</a>
                    </li>
                    <li>
                        <a href="/servicios/cableado-estructurado"
                            >Cableado estructurado</a>
                    </li>
                    <li>
                        <a href="/servicios/configuracion-routers-switches"
                            >Configuración de redes</a>
                    </li>
                    <li>
                        <a href="/servicios/redes-inalambricas-wifi"
                            >Redes inalámbricas</a>
                    </li>
                    <li>
                        <a href="/servicios/soporte-tecnico">Soporte técnico</a>
                    </li>
                </ul>
            </div>

            <div>
                <h3 class={styles['footer-heading']}>Empresa</h3>
                <ul class={styles['footer-links']}>
                    <li><a href="/nosotros">Sobre nosotros</a></li>
                    <li><a href="#beneficios">Beneficios</a></li>
                    <li><a href="#faq">Preguntas frecuentes</a></li>
                    <li><a href="#contacto">Contacto</a></li>
                </ul>
            </div>

            <div>
                <h3 class={styles['footer-heading']}>Contacto directo</h3>
                <ul class={styles['footer-contact-list']}>
                    <li class={styles['footer-contact-item']}>
                        <span class={styles['footer-contact-label']}>Teléfono</span>
                        <a href="tel:+571234513541">+57 123 4513541</a>
                    </li>
                    <li class={styles['footer-contact-item']}>
                        <span class={styles['footer-contact-label']}>WhatsApp</span>
                        <a
                            href="https://wa.me/571234513541"
                            target="_blank"
                            rel="noopener noreferrer">+57 123 4513541</a
                        >
                    </li>
                    <li class={styles['footer-contact-item']}>
                        <span class={styles['footer-contact-label']}>Ubicación</span>
                        Calle 41, Cra 31 #00, Cali
                    </li>
                </ul>
            </div>
        </div>

        <div class={styles['footer-bottom']}>
            <p class={styles['footer-copy']}>
                &copy; {new Date().getFullYear()} Sistek. Todos los derechos reservados.
            </p>
            <div class={styles['footer-legal']}>
                <a href="/privacidad">Aviso de privacidad</a>
                <a href="/terminos">Términos y condiciones</a>
                <a href="/auth">sistema</a>
            </div>
        </div>
    </div>
</footer>
