---
import { IconBrandTwitter, IconBrandLinkedin, IconBrandInstagram, IconBrandFacebook, IconArrowUp } from '@tabler/icons-react';
import '@/styles/landingPage/Footer.css';
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Sistek - Inicio">
          <img src="/logo_icono.png" class="footer-logo-icon" alt="Sistek logo icono" width="32" height="32" loading="lazy" />
          <img src="/logo_name.png" class="footer-logo-name" alt="Sistek" width="100" height="32" loading="lazy" />
        </a>
        <p class="footer-desc">
          Infraestructura tecnológica, redes empresariales y soporte técnico profesional en Cali, Colombia. Transformamos tu tecnología para impulsar tu negocio.
        </p>
        <div class="footer-social">
          <a href="https://www.instagram.com/sistek" aria-label="Sistek en Instagram" target="_blank" rel="noopener noreferrer"><IconBrandInstagram aria-hidden="true" /></a>
          <a href="https://www.facebook.com/sistek" aria-label="Sistek en Facebook" target="_blank" rel="noopener noreferrer"><IconBrandFacebook aria-hidden="true" /></a>
        </div>
      </div>

      <div>
        <h3 class="footer-heading">Servicios</h3>
        <ul class="footer-links">
          <li><a href="/servicios/mantenimiento-computadores">Mantenimiento de equipos</a></li>
          <li><a href="/servicios/instalacion-redes-empresariales">Instalación de redes</a></li>
          <li><a href="/servicios/cableado-estructurado">Cableado estructurado</a></li>
          <li><a href="/servicios/configuracion-routers-switches">Configuración de redes</a></li>
          <li><a href="/servicios/redes-inalambricas-wifi">Redes inalámbricas</a></li>
          <li><a href="/servicios/soporte-tecnico">Soporte técnico</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-heading">Empresa</h3>
        <ul class="footer-links">
          <li><a href="/nosotros">Sobre nosotros</a></li>
          <li><a href="#beneficios">Beneficios</a></li>
          <li><a href="#faq">Preguntas frecuentes</a></li>
          <li><a href="#contacto">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h3 class="footer-heading">Contacto directo</h3>
        <ul class="footer-contact-list">
          <li class="footer-contact-item">
            <span class="footer-contact-label">Teléfono</span>
            <a href="tel:+571234513541">+57 123 4513541</a>
          </li>
          <li class="footer-contact-item">
            <span class="footer-contact-label">Email</span>
            <a href="mailto:contacto@sistek.com.co">contacto@sistek.com.co</a>
          </li>
          <li class="footer-contact-item">
            <span class="footer-contact-label">WhatsApp</span>
            <a href="https://wa.me/571234513541" target="_blank" rel="noopener noreferrer">+57 123 4513541</a>
          </li>
          <li class="footer-contact-item">
            <span class="footer-contact-label">Ubicación</span>
            Calle 41, Cra 31 #00, Cali
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">&copy; {new Date().getFullYear()} Sistek. Todos los derechos reservados.</p>
      <div class="footer-legal">
        <a href="/privacidad">Aviso de privacidad</a>
        <a href="/terminos">Términos y condiciones</a>
        <a href="/sistema">sistema</a>
      </div>
      <a href="#inicio" class="back-to-top" aria-label="Volver arriba"><IconArrowUp aria-hidden="true" /></a>
    </div>
  </div>
</footer>
