---
import styles from "@/styles/About.module.css";
---

<section id="about" aria-labelledby="about-heading">
  <div class="container">
    <div class={styles['about-grid']}>
      <div class={styles['about-content']}>
        <h2 id="about-heading" class={styles['about-title']}>
          Técnicos de redes en Cali, Valle del Cauca
        </h2>
        <p class={styles['about-text']}>
          <strong>Sistek</strong> instala, configura y mantiene redes empresariales,
          cableado estructurado y equipos de cómputo en Cali y el Valle del Cauca.
        </p>
        <p class={styles['about-text']}>
          Atendemos empresas, colegios y negocios. Cada proyecto incluye
          cotización con precio cerrado, garantía escrita y seguimiento.
        </p>
        <ul class={styles['about-grid-2x2']}>
          <li class={styles['about-feature']}>
            <div>
              <div class={styles['about-feature-title']}>Cali, Valle del Cauca</div>
              <div class={styles['about-feature-desc']}>Atendemos toda la ciudad y el área metropolitana</div>
            </div>
          </li>
          <li class={styles['about-feature']}>
            <div>
              <div class={styles['about-feature-title']}>Responsable asignado</div>
              <div class={styles['about-feature-desc']}>Cada servicio tiene un técnico responsable del seguimiento</div>
            </div>
          </li>
          <li class={styles['about-feature']}>
            <div>
              <div class={styles['about-feature-title']}>Soporte después de la entrega</div>
              <div class={styles['about-feature-desc']}>Atención presencial y remota para ajustes y fallas</div>
            </div>
          </li>
          <li class={styles['about-feature']}>
            <div>
              <div class={styles['about-feature-title']}>Personal capacitado</div>
              <div class={styles['about-feature-desc']}>Capacitación en las marcas que instalamos</div>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
