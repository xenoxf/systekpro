---
import { IconArrowRight, IconHeadset } from '@tabler/icons-react';
import styles from "@/styles/CTA.module.css";
---

<section class={styles['cta-section']}>
  <div class={styles['cta-card']}>
    <div class={styles['cta-card-inner']}>
      <h2 class={styles['cta-title']}>
        ¿Necesitas que tus redes funcionen de verdad?
      </h2>
      <p class={styles['cta-desc']}>
        Sin compromiso. Te decimos qué necesitás, cuánto cuesta y cuándo queda listo. Si no te convence, no pasa nada.
      </p>
      <div class={styles['cta-actions']}>
        <a href="#contacto" class="btn-primary">
          Solicitar cotización
          <IconArrowRight aria-hidden="true" />
        </a>
        <a href="tel:+571234513541" class="btn-secondary">
          <IconHeadset aria-hidden="true" />
          Llamar ahora
        </a>
      </div>
      <div class={styles['cta-features']}>
        <span>Sin compromiso</span>
        <span>·</span>
        <span>Técnico directo</span>
        <span>·</span>
        <span>Garantía escrita</span>
      </div>
    </div>
  </div>
</section>
