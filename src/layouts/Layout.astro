---
import "@/styles/starwind.css";
import "@/styles/base.css";
import Toaster from '../components/starwind/toast/Toaster.astro'

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  accessibility?: boolean;
}

const {
  title = "Sistek Pro - Infraestructura tecnológica, Redes y Soporte Técnico en Cali",
  description = "Sistek Pro: empresa de mantenimiento de computadores, instalación de redes empresariales, cableado estructurado y soporte técnico en Cali, Colombia. Cotización gratuita.",
  image = "/og-image.svg",
  canonical = Astro.url.href,
  accessibility = true
} = Astro.props;

const siteUrl = "https://sistekpro.vercel.app";
const fullImage = image.startsWith("http") ? image : `${siteUrl}${image}`;
const fullCanonical = canonical.startsWith("http") ? canonical : `${siteUrl}${canonical}`;
const currentPath = Astro.url.pathname;

const breadcrumbs = [
  { name: "Inicio", url: siteUrl },
  ...(currentPath !== '/' ? [{ name: title.split(' | ')[0], url: `${siteUrl}${currentPath}` }] : [])
];

const jsonLdLocalBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Sistek",
  "alternateName": "Sistek Pro",
  "image": `${siteUrl}/logo.png`,
  "logo": `${siteUrl}/logo.png`,
  "description": description,
  "url": siteUrl,
  "telephone": "+57-123-4513541",
  "email": "contacto@sistek.com.co",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Calle 41, Cra 31 #00",
    "addressLocality": "Cali",
    "addressRegion": "Valle del Cauca",
    "postalCode": "760001",
    "addressCountry": "CO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "3.4516",
    "longitude": "-76.5320"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Tuesday"],
      "opens": "13:00",
      "closes": "17:00"
    }
  ],
  "priceRange": "$$",
  "areaServed": {
    "@type": "City",
    "name": "Cali",
    "sameAs": "https://es.wikipedia.org/wiki/Cali"
  },
  "sameAs": [
    "https://www.instagram.com/sistek",
    "https://www.facebook.com/sistek"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios tecnológicos",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mantenimiento de Computadores" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Instalación de Redes Empresariales" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cableado Estructurado" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Configuración de Routers y Switches" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Redes WiFi Empresariales" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Soporte Técnico" } }
    ]
  }
};

const jsonLdOrganization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Sistek",
  "url": siteUrl,
  "logo": `${siteUrl}/logo.png`,
  "description": "Empresa de infraestructura tecnológica, redes empresariales y soporte técnico en Cali, Colombia.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Cali",
    "addressRegion": "Valle del Cauca",
    "addressCountry": "CO"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+57-123-4513541",
    "contactType": "customer service",
    "areaServed": "CO",
    "availableLanguage": "Spanish"
  },
  "sameAs": [
    "https://www.instagram.com/sistek",
    "https://www.facebook.com/sistek"
  ]
};

const jsonLdWebSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Sistek",
  "url": siteUrl,
  "description": "Servicios de infraestructura tecnológica, redes empresariales y soporte técnico en Cali.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/?s={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
};

const jsonLdBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": crumb.name,
    "item": crumb.url
  }))
};
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <script>
      (function() {
        try {
          if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href="/icono.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href="/icono_white.png" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/x-icon" href="/icono.ico" />
    <link rel="apple-touch-icon" href="/icono.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Core -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sistek" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={fullCanonical} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="es-CO" href={fullCanonical} />
    <link rel="alternate" hreflang="es" href={fullCanonical} />

    <!-- Google Verification -->
    <meta name="google-site-verification" content="bUWA640cYC5xTz1CRqp5SlH2r6aH8-E_nhgSWgb3T9I" />

    <!-- Theme -->
    <meta name="theme-color" id="theme-color" content="#0B1121" />
    <meta name="msapplication-TileColor" content="#0B1121" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={fullImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Sistek - ${title}`} />
    <meta property="og:site_name" content="Sistek" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImage} />
    <meta name="twitter:image:alt" content={`Sistek - ${title}`} />

    <!-- Mobile / PWA -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Sistek" />

    <!-- Fonts: preload + display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdLocalBusiness)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdOrganization)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebSite)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumbs)} />


  </head>
  <body>
    <nav aria-label="Accesibilidad" class="skip-nav">
      <a href="#main" class="skip-link">Saltar al contenido principal</a>
    </nav>
    <slot />
    <Toaster position="bottom-right" duration={3000} />
    {accessibility && (
      <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/sienna-accessibility/dist/sienna-accessibility.umd.js"
        async
      />
    )}
    {accessibility && (
      <script is:inline>
    (function () {
      const KEY_STOP = "stop-animations";
      const STORE = "asw-user-settings";

      const css = `
        .a11y-stop-anim *, .a11y-stop-anim {
          animation: none !important;
          transition: none !important;
          scroll-behavior: auto !important;
        }
        .asw-btn[data-key="hide-images"],
        .asw-btn[data-key="image-tooltips"] {
          display: none !important;
        }
      `;

      function ensureStyle() {
        let s = document.getElementById("a11y-custom-style");
        if (!s) {
          s = document.createElement("style");
          s.id = "a11y-custom-style";
          s.textContent = css;
          document.head.appendChild(s);
        }
        return s;
      }

      function getStates() {
        try {
          return JSON.parse(localStorage.getItem(STORE) || "{}").states || {};
        } catch (e) {
          return {};
        }
      }

      function applyStop(on) {
        document.documentElement.classList.toggle("a11y-stop-anim", on);
        if (on) {
          document.querySelectorAll("video[autoplay]").forEach(function (v) {
            try { v.pause(); v.removeAttribute("autoplay"); } catch (e) {}
          });
        }
      }

      function syncFromButton(btn) {
        if (!btn) return;
        if (btn.dataset.key !== KEY_STOP) return;
        applyStop(btn.classList.contains("asw-selected"));
      }

      function applyAll() {
        applyStop(!!getStates()[KEY_STOP]);
      }

      function watch() {
        document.addEventListener("click", function (e) {
          const btn = e.target.closest && e.target.closest(".asw-btn, .asw-profile-btn");
          if (btn && btn.dataset.key === KEY_STOP) {
            setTimeout(function () { syncFromButton(btn); }, 0);
          }
        }, true);
      }

      ensureStyle();
      watch();
      applyAll();
      window.addEventListener("load", function () {
        applyAll();
        const st = getStates();
        if (st[KEY_STOP]) applyStop(true);
      });
    })();
  </script>
    )}
  </body>
</html>
