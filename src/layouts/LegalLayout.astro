---
import "@/styles/base.css";
import "@/styles/legal.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sistek",
  description = "Información legal de Sistek - Infraestructura tecnológica y redes empresariales en Cali, Colombia."
} = Astro.props;

const siteUrl = "https://sistek.com.co";
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo_icono.svg" />
    <link rel="icon" type="image/x-icon" href="/logo_icono.ico" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script>
      (function() {
        var theme = localStorage.getItem('theme');
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        if (theme === 'light' || (!theme && prefersLight)) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
  </head>
  <body>
    <nav aria-label="Accesibilidad" class="skip-nav">
      <a href="#main" class="skip-link">Saltar al contenido principal</a>
    </nav>
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
