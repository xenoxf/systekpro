---
import "@/styles/base.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sistek",
  description = "Información legal de Sistek - Infraestructura tecnológica y redes empresariales en Cali, Colombia."
} = Astro.props;

const siteUrl = "https://sistek.com.co";
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/logo_icono.svg" />
    <link rel="icon" type="image/x-icon" href="/logo_icono.ico" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script>
      (function() {
        var theme = localStorage.getItem('theme');
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        if (theme === 'light' || (!theme && prefersLight)) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>
    <script is:inline>
      try {
        var s = JSON.parse(localStorage.getItem('sistek.a11y') || '{}');
        var c = document.documentElement.classList;
        if (s.scale) c.add('a11y-scale-' + s.scale);
        ['contrast', 'grayscale', 'links', 'legible', 'motionOff'].forEach(function (k) {
          if (s[k]) c.add('a11y-' + k);
        });
      } catch (e) {}
    </script>
  </head>
  <body>
    <nav aria-label="Accesibilidad" class="skip-nav">
      <a href="#main" class="skip-link">Saltar al contenido principal</a>
    </nav>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <script>
      import "@/scripts/accessibility";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --bg-card: #ffffff;
    --text: #000000;
    --text-secondary: #333333;
    --border: #e0e0e0;
    --primary: #000000;
    --accent: #000000;
    --muted: #f5f5f5;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-color: #ffffff;
    color: #000000;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background-color: #e0e0e0; }
  .legal-container { max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
  .legal-title { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; }
  .legal-date { font-size: 0.875rem; color: #666666; margin-bottom: 2.5rem; }
  .legal-section { margin-bottom: 2rem; }
  .legal-section h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.75rem; }
  .legal-section h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; margin-top: 1rem; }
  .legal-section p { margin-bottom: 0.75rem; color: #333333; }
  .legal-section ul { margin: 0.5rem 0 1rem 1.5rem; color: #333333; }
  .legal-section li { margin-bottom: 0.375rem; }
  .legal-section strong { color: #000000; }
</style>
